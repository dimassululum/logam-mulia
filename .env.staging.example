COMPOSE_PROJECT_NAME=logam-mulia-staging
NODE_ENV=production

POSTGRES_USER=postgres
POSTGRES_DB=antam_staging
DB_PASSWORD=change_me_staging
DATABASE_URL=postgresql://postgres:change_me_staging@db:5432/antam_staging?schema=public

PUBLIC_API_URL=https://staging.logam-mulia-antam.com/api
FRONTEND_URL=https://staging.logam-mulia-antam.com
FRONTEND_URLS=
NEXT_PUBLIC_API_URL=https://staging.logam-mulia-antam.com/api
INTERNAL_API_ORIGIN=http://backend:5000

JWT_ACCESS_SECRET=change_me_staging_access_secret
JWT_REFRESH_SECRET=change_me_staging_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_ORIGIN_SEARCH=Jakarta Timur

RESEND_API_KEY=
EMAIL_FROM=noreply@logam-mulia-antam.com
ADMIN_ORDER_NOTIFICATION_EMAIL=

MAX_FILE_SIZE_MB=10
BACKEND_BIND_ADDR=127.0.0.1
BACKEND_HOST_PORT=5100
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_HOST_PORT=4100

CLOUDFLARED_CONFIG_FILE=./cloudflared/config.staging.yml
CLOUDFLARED_CREDENTIALS_FILE=./cloudflared/staging-credentials.json
