COMPOSE_PROJECT_NAME=logam-mulia-local
NODE_ENV=production

POSTGRES_USER=postgres
POSTGRES_DB=antam_local
DB_PASSWORD=change_me_local
DATABASE_URL=postgresql://postgres:change_me_local@db:5432/antam_local?schema=public

PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
INTERNAL_API_ORIGIN=http://backend:5000

JWT_ACCESS_SECRET=change_me_local_access_secret
JWT_REFRESH_SECRET=change_me_local_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_ORIGIN_SEARCH=Jakarta Timur

RESEND_API_KEY=
EMAIL_FROM=noreply@logam-mulia-antam.com
ADMIN_ORDER_NOTIFICATION_EMAIL=

MAX_FILE_SIZE_MB=10
BACKEND_BIND_ADDR=127.0.0.1
BACKEND_HOST_PORT=5000
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_HOST_PORT=3000
