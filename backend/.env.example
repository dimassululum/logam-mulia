# ===========================
# SERVER
# ===========================
NODE_ENV=development
PORT=5000
PUBLIC_API_URL="http://localhost:5000"

# ===========================
# DATABASE
# ===========================
DATABASE_URL="postgresql://postgres:password@localhost:5432/antam_db?schema=public"

# ===========================
# AUTHENTICATION
# ===========================
JWT_ACCESS_SECRET="ganti_dengan_random_string_yang_panjang"
JWT_REFRESH_SECRET="ganti_dengan_random_string_lain_yang_panjang"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ===========================
# MIDTRANS PAYMENT GATEWAY
# ===========================
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxx"
MIDTRANS_IS_PRODUCTION=false

# ===========================
# RAJA ONGKIR
# ===========================
RAJAONGKIR_API_KEY="rajaongkir_api_key_here"
RAJAONGKIR_BASE_URL="https://api.rajaongkir.com/starter"

# ===========================
# EMAIL SERVICE (Resend/SMTP)
# ===========================
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@logam-mulia-antam.com"

# ===========================
# STORAGE (File Upload)
# ===========================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# ===========================
# FRONTEND URL (untuk CORS)
# ===========================
FRONTEND_URL="http://localhost:3000"
