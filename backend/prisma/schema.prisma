// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================
// ENUM TYPES
// ===========================

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ===========================
// MODELS
// ===========================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?
  role          Role      @default(CUSTOMER)
  ktpUrl        String?   @map("ktp_url")      // Path file KTP terenkripsi (private storage)
  isKycVerified Boolean   @default(false) @map("is_kyc_verified")
  isActive      Boolean   @default(true) @map("is_active")
  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  reviews       Review[]
  contents      Content[] @relation("ContentAuthor")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  label     String   // "Rumah", "Kantor", dll
  address   String
  city      String
  province  String
  postalCode String  @map("postal_code")
  isDefault Boolean  @default(false) @map("is_default")

  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  parentId    String?   @map("parent_id")
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  promos      Promo[]

  @@map("categories")
}

model Product {
  id          String         @id @default(uuid())
  categoryId  String         @map("category_id")
  category    Category       @relation(fields: [categoryId], references: [id])
  name        String
  slug        String         @unique
  description String?
  price       Decimal        @db.Decimal(15, 2)
  weightGram  Decimal        @map("weight_gram") @db.Decimal(10, 3)
  kadar       String         // "24K", "22K", "18K", dll
  stock       Int            @default(0)
  isActive      Boolean        @default(true) @map("is_active")
  averageRating Decimal        @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount   Int            @default(0) @map("review_count")
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  promos        Promo[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String    @map("image_url")
  altText   String?   @map("alt_text")
  isPrimary Boolean   @default(false) @map("is_primary")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("product_images")
}

model Order {
  id                   String      @id // Custom: INV-20250425-001
  userId               String      @map("user_id")
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal     @map("total_amount") @db.Decimal(15, 2)
  shippingCost         Decimal     @map("shipping_cost") @db.Decimal(15, 2)
  discountAmount       Decimal     @default(0) @map("discount_amount") @db.Decimal(15, 2)
  grandTotal           Decimal     @map("grand_total") @db.Decimal(15, 2)
  shippingAddress      String      @map("shipping_address")
  shippingCity         String      @map("shipping_city")
  shippingCourier      String?     @map("shipping_courier")  // JNE, Paxel, SELFPICKUP
  trackingNumber       String?     @map("tracking_number")
  ktpImageUrl          String?     @map("ktp_image_url")     // Path KTP customer
  voucherId            String?     @map("voucher_id")
  voucher              Voucher?    @relation(fields: [voucherId], references: [id])
  midtransTransactionId String?    @map("midtrans_transaction_id")
  items                OrderItem[]
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String  @map("product_id")
  product         Product @relation(fields: [productId], references: [id])
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(15, 2)  // Harga dikunci saat beli
  quantity        Int
  subtotal        Decimal @db.Decimal(15, 2)

  @@map("order_items")
}

model Review {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  rating    Int     // 1-5
  comment   String?
  imageUrl  String? @map("image_url")
  isHidden  Boolean @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Voucher {
  id           String       @id @default(uuid())
  code         String       @unique
  discountType DiscountType @map("discount_type")
  discountValue Decimal     @map("discount_value") @db.Decimal(15, 2)
  minPurchase  Decimal      @default(0) @map("min_purchase") @db.Decimal(15, 2)
  maxDiscount  Decimal?     @map("max_discount") @db.Decimal(15, 2)
  usageLimit   Int?         @map("usage_limit")
  usageCount   Int          @default(0) @map("usage_count")
  perUserLimit Int          @default(1) @map("per_user_limit")
  isActive     Boolean      @default(true) @map("is_active")
  startsAt     DateTime?    @map("starts_at")
  expiresAt    DateTime?    @map("expires_at")
  orders       Order[]

  @@map("vouchers")
}

model Promo {
  id           String       @id @default(uuid())
  name         String
  discountType DiscountType @map("discount_type")
  discountValue Decimal     @map("discount_value") @db.Decimal(15, 2)
  products     Product[]
  categories   Category[]
  startsAt     DateTime?    @map("starts_at")
  expiresAt    DateTime?    @map("expires_at")
  isActive     Boolean      @default(true) @map("is_active")

  @@map("promos")
}

model Setting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  isActive  Boolean  @default(true) @map("is_active")
  position  String   @default("home") // home, category, product
  sortOrder Int      @default(0) @map("sort_order")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model Content {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String   // HTML content
  excerpt   String?  // Short description
  type      String   @default("page") // page, post, announcement
  status    String   @default("published") // published, draft, archived
  imageUrl  String?  @map("image_url")
  authorId  String   @map("author_id")
  author    User     @relation("ContentAuthor", fields: [authorId], references: [id])
  seoTitle String?  @map("seo_title")
  seoDesc   String?  @map("seo_desc")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contents")
}
